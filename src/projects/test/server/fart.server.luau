g.Source =
	'script.Parent.SaveLabel.Text = ("Slot: " .. script.Parent.Name)\n\nlocal gui = script.Parent.Parent.Parent.Parent.Parent\nlocal saveTable = {}\n\nfunction OnSave()\n\tscript.Parent.SaveLoad:FireServer("Save")\nend\n\nfunction OnLoad()\n\tscript.Parent.SaveLoad:FireServer("Load")\nend\n\nscript.Parent.Save.Activated:Connect(OnSave)\nscript.Parent.Load.Activated:Connect(OnLoad)\n'
