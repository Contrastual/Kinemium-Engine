local h = Instance.new("Script")
h.Name = "SaveLoadScript"
h.Enabled = false
h.Disabled = true
h.Source =
	'local DataStoreService = game:GetService("DataStoreService")\nlocal httpService = game:GetService("HttpService")\nlocal gui = script.Parent.Parent.Parent.Parent.Parent.Parent\nlocal creationStore = DataStoreService:GetDataStore("Creation " .. script.Parent.Name)\n\nlocal player = script.Parent.Parent.Parent.Parent.Parent.Parent.Parent.Parent\nlocal playerUserID = player.UserId\n\nfunction OnEvent(skid, event)\n\tif gui.Values.Spawned.Value == false then\n\t\tif event == ("Save") and skid == player then\n\t\t\tlocal saveTable = {}\n\t\t\tlocal plot = nil\n\t\t\t\n\t\t\tfor i,v in pairs (workspace.Plots:GetChildren()) do\n\t\t\t\tif v.Owner.Value == player.Name then\n\t\t\t\t\tplot = v\n\t\t\t\tend\n\t\t\tend\n\t\t\t\n\t\t\tfor i,v in pairs (player.Character:FindFirstChild("Creation"):GetChildren()) do\n\t\t\t\tlocal configTable = {}\n\t\t\t\t\n\t\t\t\tfor i,c in pairs (v.Configuration:GetChildren()) do\n\t\t\t\t\tif c:IsA("StringValue") then\n\t\t\t\t\t\ttable.insert(configTable, #configTable + 1, {vn = c.Name, val = {c.Value}})\n\t\t\t\t\telse\n\t\t\t\t\t\tif c:IsA("Color3Value") then\n\t\t\t\t\t\t\ttable.insert(configTable, #configTable + 1, {vn = c.Name, val = {r = tostring(math.floor(c.Value.R *255)), g = tostring(math.floor(c.Value.G *255)), b = tostring(math.floor(c.Value.B *255))}})\n\t\t\t\t\t\tend\n\t\t\t\t\t\t\n\t\t\t\t\t\tif c:IsA("Vector3Value") then\n\t\t\t\t\t\t\ttable.insert(configTable, #configTable + 1, {vn = c.Name, val = {x = tostring(c.Value.X), y = tostring(c.Value.Y), z = tostring(c.Value.Z)}})\n\t\t\t\t\t\tend\n\t\t\t\t\t\t\n\t\t\t\t\t\tif c:IsA("IntValue") or c:IsA("NumberValue") then\n\t\t\t\t\t\t\ttable.insert(configTable, #configTable + 1, {vn = c.Name, val = {tostring(c.Value)}})\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\t\n\t\t\t\ttable.insert(saveTable, #saveTable + 1, {config = configTable, id = v.PartID.Value, x = tostring(v.MainPart.Position.X -plot.Position.X), y = tostring(v.MainPart.Position.Y -plot.Position.Y), z = tostring(v.MainPart.Position.Z -plot.Position.Z), rx = tostring(v.MainPart.Orientation.X), ry = tostring(v.MainPart.Orientation.Y), rz = tostring(v.MainPart.Orientation.Z)})\n\t\t\tend\n\t\t\t\n\t\t\tlocal saveSuccess, errorMessage = pcall(function()\n\t\t\t\tlocal jsonTable = httpService:JSONEncode(saveTable)\n\t\t\t\tcreationStore:SetAsync(playerUserID, jsonTable)\n\t\t\tend)\n\t\t\t\n\t\t\tif not saveSuccess then\n\t\t\t\twarn(errorMessage)\n\t\t\t\tscript.Parent.Save.Text = ("SAVE FAILURE: " .. errorMessage)\n\t\t\t\tscript.Parent.Save.BackgroundColor3 = Color3.fromRGB(220, 0, 0)\n\t\t\t\twait(4)\n\t\t\t\tscript.Parent.Save.Text = ("Save")\n\t\t\t\tscript.Parent.Save.BackgroundColor3 = Color3.fromRGB(60, 60, 60)\n\t\t\telse\n\t\t\t\tscript.Parent.Save.Text = ("Save Success!")\n\t\t\t\tscript.Parent.Save.BackgroundColor3 = Color3.fromRGB(0, 220, 0)\n\t\t\t\twait(1)\n\t\t\t\tscript.Parent.Save.Text = ("Save")\n\t\t\t\tscript.Parent.Save.BackgroundColor3 = Color3.fromRGB(60, 60, 60)\n\t\t\tend\n\t\telseif skid == player then\n\t\t\tlocal startTime = game.Workspace.DistributedGameTime\n\t\t\t\n\t\t\tlocal loadSuccess, loadedCreation = pcall(function()\n\t\t\t\treturn creationStore:GetAsync(playerUserID)\n\t\t\tend)\n\t\t\t\n\t\t\tif loadSuccess then\n\t\t\t\tplayer.Character:FindFirstChild("Creation"):Destroy()\n\t\t\t\t\n\t\t\t\tlocal newCreation = Instance.new("Model")\n\t\t\t\tnewCreation.Name = ("Creation")\n\t\t\t\t\n\t\t\t\tif loadedCreation ~= nil then\n\t\t\t\t\tlocal plot = nil\n\t\t\t\t\t\n\t\t\t\t\tfor i,v in pairs (workspace.Plots:GetChildren()) do\n\t\t\t\t\t\tif v.Owner.Value == player.Name then\n\t\t\t\t\t\t\tplot = v\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\t\t\n\t\t\t\t\tlocal unpacked = httpService:JSONDecode(loadedCreation)\n\t\t\t\t\t\n\t\t\t\t\tfor i,b in pairs (unpacked) do\n\t\t\t\t\t\tfor i,p in pairs (game.ReplicatedStorage.Parts:GetChildren()) do\n\t\t\t\t\t\t\tif p.PartID.Value == b.id then\n\t\t\t\t\t\t\t\tgui.Values.LoadPart.Position = Vector3.new(tonumber(b.x), tonumber(b.y), tonumber(b.z)) + plot.Position\n\t\t\t\t\t\t\t\tgui.Values.LoadPart.Orientation = Vector3.new(tonumber(b.rx), tonumber(b.ry), tonumber(b.rz))\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\tlocal placeBlock = p:Clone()\n\t\t\t\t\t\t\t\tplaceBlock.Parent = newCreation\n\t\t\t\t\t\t\t\tplaceBlock:SetPrimaryPartCFrame(gui.Values.LoadPart.CFrame)\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\tfor i,v in pairs (placeBlock:GetDescendants()) do\n\t\t\t\t\t\t\t\t\tif v.Parent == placeBlock.Configuration then\n\t\t\t\t\t\t\t\t\t\tfor i,c in pairs (b.config) do\n\t\t\t\t\t\t\t\t\t\t\tif v.Name == c.vn then\n\t\t\t\t\t\t\t\t\t\t\t\tif v:IsA("StringValue") then\n\t\t\t\t\t\t\t\t\t\t\t\t\tfor i,s in pairs (c.val) do\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tv.Value = s\n\t\t\t\t\t\t\t\t\t\t\t\t\tend\n\t\t\t\t\t\t\t\t\t\t\t\telse\n\t\t\t\t\t\t\t\t\t\t\t\t\tif v:IsA("Color3Value") then\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tv.Value = Color3.fromRGB(tonumber(c.val.r), tonumber(c.val.g), tonumber(c.val.b))\n\t\t\t\t\t\t\t\t\t\t\t\t\tend\n\t\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\tif v:IsA("Vector3Value") then\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tv.Value = Vector3.new(tonumber(c.val.x), tonumber(c.val.y), tonumber(c.val.z))\n\t\t\t\t\t\t\t\t\t\t\t\t\tend\n\t\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\tif v:IsA("IntValue") or v:IsA("NumberValue") then\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tfor i,s in pairs (c.val) do\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tv.Value = tonumber(s)\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tend\n\t\t\t\t\t\t\t\t\t\t\t\t\tend\n\t\t\t\t\t\t\t\t\t\t\t\tend\n\t\t\t\t\t\t\t\t\t\t\tend\n\t\t\t\t\t\t\t\t\t\tend\n\t\t\t\t\t\t\t\t\telse\n\t\t\t\t\t\t\t\t\t\tif v:IsA("BasePart") then\n\t\t\t\t\t\t\t\t\t\t\tv.Size = Vector3.new(v.Size.X + 0.01, v.Size.Y + 0.01, v.Size.Z + 0.01)\n\t\t\t\t\t\t\t\t\t\tend\n\t\t\t\t\t\t\t\t\tend\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\tplaceBlock.ApplySettings:Fire()\n\t\t\t\t\t\t\t\tend\n\t\t\t\t\t\t\tend\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\t\n\t\t\t\tnewCreation.Parent = player.Character\n\t\t\t\t\n\t\t\t\tprint("Total load time: " .. tostring(math.abs(startTime -workspace.DistributedGameTime)))\n\t\t\tend\n\t\tend\n\tend\nend\n\nscript.Parent.SaveLoad.OnServerEvent:Connect(OnEvent)\n'
